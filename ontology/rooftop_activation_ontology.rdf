    <!-- https://w3id.org/rooftop_activation#No_framework_for_data_and_monitoring -->

    <owl:NamedIndividual rdf:about="https://w3id.org/rooftop_activation#No_framework_for_data_and_monitoring">
        <rdf:type rdf:resource="https://w3id.org/rooftop_activation#Governance_Challenge"/>
        <rdfs:comment xml:lang="en">Absence of a common framework to collect, share and monitor data on urban interventions and their effects.</rdfs:comment>
        <rdfs:label xml:lang="en">No framework for data and monitoring</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rooftop_activation#No_regulation_framework_to_enforce_strategies -->

    <owl:NamedIndividual rdf:about="https://w3id.org/rooftop_activation#No_regulation_framework_to_enforce_strategies">
        <rdf:type rdf:resource="https://w3id.org/rooftop_activation#Governance_Challenge"/>
        <rdfs:comment xml:lang="en">Absence of a regulatory framework that makes it possible to enforce adopted urban strategies.</rdfs:comment>
        <rdfs:label xml:lang="en">No regulation framework to enforce strategies</rdfs:label>
    </owl:NamedIndividual>
    



    <owl:NamedIndividual rdf:about="https://w3id.org/rooftop_activation#Traffic_congestion">
        <rdf:type rdf:resource="https://w3id.org/rooftop_activation#Sustainable_and_Equitable_Mobility_Challenge"/>
        <rdfs:comment xml:lang="en">Road traffic volumes that exceed network capacity, causing delays, emissions and noise.</rdfs:comment>
        <rdfs:label xml:lang="en">Traffic congestion</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rooftop_activation#Transformation_heritage_restriction_for_energy_systems -->

    <owl:NamedIndividual rdf:about="https://w3id.org/rooftop_activation#Transformation_heritage_restriction_for_energy_systems">
        <rdf:type rdf:resource="https://w3id.org/rooftop_activation#Decarbonizing_Energy_Systems_Challenge"/>
        <rdfs:comment xml:lang="en">Heritage protection rules that limit the installation of energy systems, such as solar panels or heat pumps, on protected buildings.</rdfs:comment>
        <rdfs:label xml:lang="en">Transformation (heritage) restriction for energy systems</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rooftop_activation#Transformation_heritage_restriction_for_housing -->

    <owl:NamedIndividual rdf:about="https://w3id.org/rooftop_activation#Transformation_heritage_restriction_for_housing">
        <rdf:type rdf:resource="https://w3id.org/rooftop_activation#Affordable_Housing_Challenge"/>
        <rdfs:comment xml:lang="en">Heritage protection rules that limit the conversion, extension or densification of buildings for housing.</rdfs:comment>
        <rdfs:label xml:lang="en">Transformation (heritage) restriction for housing</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rooftop_activation#Trash_collection_systems -->

    <owl:NamedIndividual rdf:about="https://w3id.org/rooftop_activation#Trash_collection_systems">
        <rdf:type rdf:resource="https://w3id.org/rooftop_activation#Transition_to_a_Circular_Economy_Challenge"/>
        <rdfs:comment xml:lang="en">Waste collection systems that are inefficient or poorly suited to separation and recovery of materials.</rdfs:comment>
        <rdfs:label xml:lang="en">Trash collection systems</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rooftop_activation#Unequal_access_to_services_facilities -->

    <owl:NamedIndividual rdf:about="https://w3id.org/rooftop_activation#Unequal_access_to_services_facilities">
        <rdf:type rdf:resource="https://w3id.org/rooftop_activation#Social_Inequality_and_Segregation_Challenge"/>
        <rdfs:comment xml:lang="en">Uneven distribution of services and facilities, leaving some groups or areas underserved.</rdfs:comment>
        <rdfs:label xml:lang="en">Unequal access to services/facilities</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rooftop_activation#Urban_heat_islands -->

    <owl:NamedIndividual rdf:about="https://w3id.org/rooftop_activation#Urban_heat_islands">
        <rdf:type rdf:resource="https://w3id.org/rooftop_activation#Climate_Adaptation_and_Resilience_Challenge"/>
        <rdfs:comment xml:lang="en">Higher temperatures in dense urban areas than in their surroundings, caused by built surfaces and lack of vegetation.</rdfs:comment>
        <rdfs:label xml:lang="en">Urban heat islands</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rooftop_activation#Use_or_Access_Instrument -->

    <owl:NamedIndividual rdf:about="https://w3id.org/rooftop_activation#Use_or_Access_Instrument"/>
    



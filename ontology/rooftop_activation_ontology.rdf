    <owl:NamedIndividual rdf:about="https://w3id.org/rooftop_activation#Utilities_and_infrastructure_functions">
        <rdf:type rdf:resource="https://w3id.org/rooftop_activation#Rooftop_Function"/>
        <rdfs:comment xml:lang="en">Using the rooftop for technical installations, such as building services equipment, telecommunications antennas or network infrastructure. Realises the gray activation type.</rdfs:comment>
        <rdfs:label xml:lang="en">Utilities and infrastructure functions</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rooftop_activation#Voucher -->

    <owl:NamedIndividual rdf:about="https://w3id.org/rooftop_activation#Voucher"/>
    


    <!-- https://w3id.org/rooftop_activation#Water_overflow -->

    <owl:NamedIndividual rdf:about="https://w3id.org/rooftop_activation#Water_overflow">
        <rdf:type rdf:resource="https://w3id.org/rooftop_activation#Transition_to_a_Circular_Economy_Challenge"/>
        <rdfs:comment xml:lang="en">Overflow of sewer and drainage systems during heavy rainfall, discharging untreated water instead of retaining or reusing it.</rdfs:comment>
        <rdfs:label xml:lang="en">Water overflow</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rooftop_activation#Water_retention_function -->

    <owl:NamedIndividual rdf:about="https://w3id.org/rooftop_activation#Water_retention_function">
        <rdf:type rdf:resource="https://w3id.org/rooftop_activation#Rooftop_Function"/>
        <rdfs:comment xml:lang="en">Storing rainwater on the rooftop for later use, infiltration or evaporation. Realises the blue activation type.</rdfs:comment>
        <rdfs:label xml:lang="en">Water retention function</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rooftop_activation#Yellow_Rooftop -->

    <owl:NamedIndividual rdf:about="https://w3id.org/rooftop_activation#Yellow_Rooftop"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotations
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Advisory_Service">
        <rdfs:comment xml:lang="en">Technical, legal or financial advice provided to owners to assess and prepare a rooftop activation project.</rdfs:comment>
        <rdfs:label xml:lang="en">Advisory Service</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Blended_Finance_Program">
        <rdfs:comment xml:lang="en">A programme that combines public grant money with private capital, using the public share to lower risk or cost for private investors.</rdfs:comment>
        <rdfs:label xml:lang="en">Blended Finance Program</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Blue_Rooftop">
        <rdfs:comment xml:lang="en">A rooftop activated for water management, retaining, storing or delaying stormwater. Defined class: membership is inferred from has_function.</rdfs:comment>
        <rdfs:label xml:lang="en">Blue Rooftop</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Bond">
        <rdfs:comment xml:lang="en">A debt security issued to investors to raise capital, repaid at maturity with periodic interest.</rdfs:comment>
        <rdfs:label xml:lang="en">Bond</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Call_for_Projects_or_Competitive_Grant">
        <rdfs:comment xml:lang="en">A grant awarded through a call for projects in which applications are ranked and selected against published criteria.</rdfs:comment>
        <rdfs:label xml:lang="en">Call for Projects or Competitive Grant</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Citizen_Micro-investment_Tax_Credit">
        <rdfs:comment xml:lang="en">A tax credit granted to citizens who make small investments in local rooftop or energy projects, for example through a cooperative.</rdfs:comment>
        <rdfs:label xml:lang="en">Citizen Micro-investment Tax Credit</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Contractual_Condition">
        <rdfs:comment xml:lang="en">A clause in a lease, sale, concession or permit agreement that requires or rewards rooftop activation as a condition of the contract.</rdfs:comment>
        <rdfs:label xml:lang="en">Contractual Condition</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Contractual_or_Governance_Instrument">
        <rdfs:comment xml:lang="en">Instrument type grouping incentives set out in negotiated agreements or governance arrangements between public authorities, owners, developers or service providers.</rdfs:comment>
        <rdfs:label xml:lang="en">Contractual or Governance Instrument</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Crowdfunding_Crowdlending_and_Crowd_Equity">
        <rdfs:comment xml:lang="en">Collection of small contributions from many people, usually through an online platform, as donations, loans or equity stakes in a rooftop project.</rdfs:comment>
        <rdfs:label xml:lang="en">Crowdfunding Crowdlending and Crowd Equity</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Crowdsourcing">
        <rdfs:comment xml:lang="en">Collection of ideas, rooftop offers, volunteer work or other contributions from the public to develop rooftop projects.</rdfs:comment>
        <rdfs:label xml:lang="en">Crowdsourcing</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Debt_instrument">
        <rdfs:comment xml:lang="en">Instrument type grouping incentives that provide repayable capital, where the recipient returns the principal, usually with interest.</rdfs:comment>
        <rdfs:label xml:lang="en">Debt Instrument</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Developer_or_Charge_Fee">
        <rdfs:comment xml:lang="en">A fee or charge levied on developers or owners, such as a development or impact charge, whose amount is reduced or waived when a rooftop is activated.</rdfs:comment>
        <rdfs:label xml:lang="en">Developer or Charge Fee</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Digital_Platform_Service">
        <rdfs:comment xml:lang="en">An online platform that connects owners, providers, investors or users of rooftops, or manages the related processes.</rdfs:comment>
        <rdfs:label xml:lang="en">Digital Platform Service</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Direct_Transfer_Instrument">
        <rdfs:comment xml:lang="en">Instrument type grouping incentives that transfer non-repayable money or value directly to the recipient.</rdfs:comment>
        <rdfs:label xml:lang="en">Direct Transfer Instrument</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Disclosure">
        <rdfs:comment xml:lang="en">An obligation to report or publish information about a building or its rooftop, such as its activation potential or performance.</rdfs:comment>
        <rdfs:label xml:lang="en">Disclosure</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#ESCO_or_Sustainability_Agreement">
        <rdfs:comment xml:lang="en">An agreement with an energy service company or similar provider that designs, finances and operates a rooftop installation, recovering its investment from the savings or revenues it generates.</rdfs:comment>
        <rdfs:label xml:lang="en">ESCO or Sustainability Agreement</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Equity_or_Collective_Finance_Instrument">
        <rdfs:comment xml:lang="en">Instrument type grouping incentives that raise capital by pooling contributions from investors or citizens in exchange for ownership, returns or repayment.</rdfs:comment>
        <rdfs:label xml:lang="en">Equity or Collective Finance Instrument</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Feed-in_Tariff">
        <rdfs:comment xml:lang="en">A guaranteed price paid for each unit of renewable energy fed into the grid from a rooftop installation, over a fixed period.</rdfs:comment>
        <rdfs:label xml:lang="en">Feed-in Tariff</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Fiscal_Instrument">
        <rdfs:comment xml:lang="en">Instrument type grouping incentives delivered through the tax system.</rdfs:comment>
        <rdfs:label xml:lang="en">Fiscal Instrument</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Fiscal_Measure">
        <rdfs:comment xml:lang="en">A tax-based measure, such as a levy, fee or rate adjustment, that makes non-activated rooftops more costly relative to activated ones.</rdfs:comment>
        <rdfs:label xml:lang="en">Fiscal Measure</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Fund">
        <rdfs:comment xml:lang="en">A pool of capital managed to finance multiple rooftop activation projects.</rdfs:comment>
        <rdfs:label xml:lang="en">Fund</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Funding_Vehicle">
        <rdfs:comment xml:lang="en">A dedicated legal entity, such as a special purpose vehicle, set up to hold and channel capital into rooftop projects.</rdfs:comment>
        <rdfs:label xml:lang="en">Funding Vehicle</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Grant">
        <rdfs:comment xml:lang="en">A non-repayable sum awarded to fund a defined rooftop project, subject to conditions on its delivery.</rdfs:comment>
        <rdfs:label xml:lang="en">Grant</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Gray_Rooftop">
        <rdfs:comment xml:lang="en">A rooftop activated for utilities and technical infrastructure, such as building services, telecommunications equipment or network installations. Defined class: membership is inferred from has_function.</rdfs:comment>
        <rdfs:label xml:lang="en">Gray Rooftop</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Green_Bond">
        <rdfs:comment xml:lang="en">A bond whose proceeds are earmarked for projects with environmental benefits, such as green, blue or solar rooftops.</rdfs:comment>
        <rdfs:label xml:lang="en">Green Bond</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Green_Project_Bond">
        <rdfs:comment xml:lang="en">A green bond issued for one or more specific green projects, where investors are exposed directly to the risk of those projects.</rdfs:comment>
        <rdfs:label xml:lang="en">Green Project Bond</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Green_Revenue">
        <rdfs:comment xml:lang="en">A green revenue bond, repaid from the revenues, fees or taxes generated by the financed projects rather than by the issuer&apos;s general balance sheet.</rdfs:comment>
        <rdfs:label xml:lang="en">Green Revenue Bond</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Green_Rooftop">
        <rdfs:comment xml:lang="en">A rooftop activated with vegetation for biodiversity, cooling and amenity, or for food production. Defined class: membership is inferred from has_function.</rdfs:comment>
        <rdfs:label xml:lang="en">Green Rooftop</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Group_Purchases_and_Collective_Project">
        <rdfs:comment xml:lang="en">Pooling of demand from several owners to buy equipment or services jointly, or to deliver a shared rooftop project, at lower cost.</rdfs:comment>
        <rdfs:label xml:lang="en">Group Purchases and Collective Project</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Home_Owner_Associations">
        <rdfs:comment xml:lang="en">Collective bodies of apartment owners. Decisions require a qualified majority, which lengthens timelines.</rdfs:comment>
        <rdfs:label xml:lang="en">Home Owner Associations</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Housing_Corporations">
        <rdfs:comment xml:lang="en">Social housing providers with large portfolios, long horizons and a public-interest mandate. It also includes Social Housing providers.</rdfs:comment>
        <rdfs:label xml:lang="en">Housing Corporations</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Industrial">
        <rdfs:comment xml:lang="en">Owners of production and logistics buildings, typically holding large flat roofs.</rdfs:comment>
        <rdfs:label xml:lang="en">Industrial owner</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Information_or_Engagement">
        <rdfs:comment xml:lang="en">Campaigns, events or outreach that raise awareness of rooftop activation and engage owners and residents.</rdfs:comment>
        <rdfs:label xml:lang="en">Information or Engagement</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Informational_Instrument">
        <rdfs:comment xml:lang="en">Instrument type grouping incentives that act by providing information, advice, recognition or tools to owners and intermediaries.</rdfs:comment>
        <rdfs:label xml:lang="en">Informational Instrument</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Institutional_Investors">
        <rdfs:comment xml:lang="en">Pension funds, insurers and similar, seeking stable long-term returns at portfolio scale.</rdfs:comment>
        <rdfs:label xml:lang="en">Institutional Investors</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Investment">
        <rdfs:comment xml:lang="en">An investment fund that takes equity or quasi-equity positions in rooftop projects in expectation of a financial return.</rdfs:comment>
        <rdfs:label xml:lang="en">Investment fund</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Label_or_Recognition">
        <rdfs:comment xml:lang="en">A certification, label or award that recognises activated rooftops and can raise their visibility or market value.</rdfs:comment>
        <rdfs:label xml:lang="en">Label or Recognition</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Landlords">
        <rdfs:comment xml:lang="en">Owners renting to occupants, subject to the split-incentive problem where the investor is not the beneficiary.</rdfs:comment>
        <rdfs:label xml:lang="en">Landlords</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Loan">
        <rdfs:comment xml:lang="en">Capital lent to an owner or project and repaid over time, usually with interest.</rdfs:comment>
        <rdfs:label xml:lang="en">Loan</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Mapping_Tools">
        <rdfs:comment xml:lang="en">Maps and cadastres that show the activation potential of rooftops, for example for solar energy, greening or water retention.</rdfs:comment>
        <rdfs:label xml:lang="en">Mapping Tools</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Offset_or_Deduction_Mechanism">
        <rdfs:comment xml:lang="en">A mechanism that allows rooftop activation to offset or be deducted from other obligations, such as required green space, parking provision or stormwater retention on the plot.</rdfs:comment>
        <rdfs:label xml:lang="en">Offset or Deduction Mechanism</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#On-bill_Financing">
        <rdfs:comment xml:lang="en">A loan for rooftop measures repaid through the owner&apos;s utility bill, typically sized so that the savings cover the repayments.</rdfs:comment>
        <rdfs:label xml:lang="en">On-bill Financing</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#On-bill_Repayment">
        <rdfs:comment xml:lang="en">A variant of on-bill financing in which the capital comes from a third-party lender while repayments are collected through the utility bill.</rdfs:comment>
        <rdfs:label xml:lang="en">On-bill Repayment</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#On-tax_Financing">
        <rdfs:comment xml:lang="en">Financing repaid through a surcharge on the property tax bill, so that the repayment obligation stays with the property when it is sold.</rdfs:comment>
        <rdfs:label xml:lang="en">On-tax Financing</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Orange_Rooftop">
        <rdfs:comment xml:lang="en">A rooftop activated for mobility or logistics, such as parking, vehicle charging, delivery hubs or drone landing. Defined class: membership is inferred from has_function.</rdfs:comment>
        <rdfs:label xml:lang="en">Orange Rooftop</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Planning_Instrument">
        <rdfs:comment xml:lang="en">Instrument type grouping incentives that act through spatial planning, strategies and public programmes.</rdfs:comment>
        <rdfs:label xml:lang="en">Planning Instrument</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Planning_or_Policy">
        <rdfs:comment xml:lang="en">A plan, strategy or policy document that sets objectives or priorities for rooftop activation in a territory.</rdfs:comment>
        <rdfs:label xml:lang="en">Planning or Policy</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Pre-financed_Grant">
        <rdfs:comment xml:lang="en">A grant paid, fully or partly, before the works are carried out, so that the recipient does not have to advance the costs.</rdfs:comment>
        <rdfs:label xml:lang="en">Pre-financed Grant</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Private_Individual">
        <rdfs:comment xml:lang="en">A single natural person owning and usually occupying the building. Short horizon, limited capital, simple decision.</rdfs:comment>
        <rdfs:label xml:lang="en">Private Individual</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Private_Project_Developers">
        <rdfs:comment xml:lang="en">Actors building for sale, deciding at design stage and rarely retaining ownership.</rdfs:comment>
        <rdfs:label xml:lang="en">Private Project Developers</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Program_or_Zoning_Approach">
        <rdfs:comment xml:lang="en">A programme or zoning rule that designates areas, targets or requirements for rooftop activation, such as a green area factor.</rdfs:comment>
        <rdfs:label xml:lang="en">Program or Zoning Approach</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Property-linked_Loans">
        <rdfs:comment xml:lang="en">A loan secured on and attached to the property rather than the borrower, so that the outstanding balance transfers with ownership.</rdfs:comment>
        <rdfs:label xml:lang="en">Property-linked Loans</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Public-Private_Partnerships">
        <rdfs:comment xml:lang="en">A long-term arrangement in which a public authority and private partners share the financing, delivery and risks of rooftop activation projects.</rdfs:comment>
        <rdfs:label xml:lang="en">Public-Private Partnerships</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Purple_Rooftop">
        <rdfs:comment xml:lang="en">A rooftop activated for human occupation, such as housing or other built extensions added on top of the building. Defined class: membership is inferred from has_function.</rdfs:comment>
        <rdfs:label xml:lang="en">Purple Rooftop</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Real_Estate">
        <rdfs:comment xml:lang="en">Professional property-owning organisations.</rdfs:comment>
        <rdfs:label xml:lang="en">Real Estate</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Real_Estate_Corporate">
        <rdfs:comment xml:lang="en">Real estate held by companies for their own operations or as an asset.</rdfs:comment>
        <rdfs:label xml:lang="en">Corporate Real Estate Owner</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Real_Estate_Municipal">
        <rdfs:comment xml:lang="en">Real estate held by a local authority, where public objectives may outweigh financial return.</rdfs:comment>
        <rdfs:label xml:lang="en">Municipal Real Estate Owner</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Red_Rooftop">
        <rdfs:comment xml:lang="en">A rooftop activated for social use, such as meeting, recreation, sport or cultural activities open to a community or the public. Defined class: membership is inferred from has_function.</rdfs:comment>
        <rdfs:label xml:lang="en">Red Rooftop</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Regulation">
        <rdfs:comment xml:lang="en">A binding rule that requires, permits or forbids rooftop activation, such as a mandatory green or solar roof for new buildings.</rdfs:comment>
        <rdfs:label xml:lang="en">Regulation</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Regulatory_Instrument">
        <rdfs:comment xml:lang="en">Instrument type grouping incentives that act through binding rules, obligations or prohibitions.</rdfs:comment>
        <rdfs:label xml:lang="en">Regulatory Instrument</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Religious_Institution">
        <rdfs:comment xml:lang="en">Faith organisations, often owning heritage buildings with limited capital and community-oriented objectives.</rdfs:comment>
        <rdfs:label xml:lang="en">Religious Institution</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Renting_or_Leasing">
        <rdfs:comment xml:lang="en">Use of rooftop space or equipment through a rental or lease, for example an owner leasing the roof to a solar operator or leasing an installation instead of buying it.</rdfs:comment>
        <rdfs:label xml:lang="en">Renting or Leasing</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Revolving">
        <rdfs:comment xml:lang="en">A revolving fund in which repayments and returns from earlier projects are reinvested in new ones.</rdfs:comment>
        <rdfs:label xml:lang="en">Revolving fund</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Revolving_Credit">
        <rdfs:comment xml:lang="en">A credit line that the borrower can draw, repay and draw again up to an agreed limit.</rdfs:comment>
        <rdfs:label xml:lang="en">Revolving Credit</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Secured_Green">
        <rdfs:comment xml:lang="en">A secured green bond, backed by collateral from one or more green projects, such as the installations or their cash flows.</rdfs:comment>
        <rdfs:label xml:lang="en">Secured Green Bond</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Standard_Green_Use_of_Proceeds_Bond">
        <rdfs:comment xml:lang="en">A green bond with recourse to the issuer&apos;s full balance sheet, whose proceeds are allocated to eligible green projects.</rdfs:comment>
        <rdfs:label xml:lang="en">Standard Green Use of Proceeds Bond</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Steward-Owned">
        <rdfs:comment xml:lang="en">A fund or company in steward ownership, where control stays with people connected to its mission and profits are bound to that purpose rather than distributed to shareholders.</rdfs:comment>
        <rdfs:label xml:lang="en">Steward-Owned</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Subsidy">
        <rdfs:comment xml:lang="en">A recurring payment or price support that reduces the cost of, or raises the return on, an activated rooftop during its operation.</rdfs:comment>
        <rdfs:label xml:lang="en">Subsidy</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#TAX_or_VAT_Incentive">
        <rdfs:comment xml:lang="en">A reduction or exemption of taxes, or a reduced VAT rate, granted automatically for eligible rooftop works or installations.</rdfs:comment>
        <rdfs:label xml:lang="en">TAX or VAT Incentive</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Tax_Credit">
        <rdfs:comment xml:lang="en">An amount deducted directly from the tax owed by an eligible taxpayer who invests in rooftop activation.</rdfs:comment>
        <rdfs:label xml:lang="en">Tax Credit</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Tools">
        <rdfs:comment xml:lang="en">Tools that help owners and professionals identify, assess or plan rooftop activation.</rdfs:comment>
        <rdfs:label xml:lang="en">Tools</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Use_or_Access_Instrument">
        <rdfs:comment xml:lang="en">Instrument type grouping incentives that give access to rooftop space, equipment or services without full ownership or up-front purchase.</rdfs:comment>
        <rdfs:label xml:lang="en">Use or Access Instrument</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Voucher">
        <rdfs:comment xml:lang="en">A voucher of fixed value that an owner can redeem for eligible goods or services, such as a feasibility study or an installation.</rdfs:comment>
        <rdfs:label xml:lang="en">Voucher</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Yellow_Rooftop">
        <rdfs:comment xml:lang="en">A rooftop activated for energy generation, typically with photovoltaic or solar thermal installations. Defined class: membership is inferred from has_function.</rdfs:comment>
        <rdfs:label xml:lang="en">Yellow Rooftop</rdfs:label>
    </rdf:Description>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // General axioms
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="http://bimerr.iot.linkeddata.es/def/building#Building"/>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_construction_year"/>
                <owl:someValuesFrom>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description>
                                <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1830</xsd:minInclusive>
                            </rdf:Description>
                            <rdf:Description>
                                <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1918</xsd:maxInclusive>
                            </rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:someValuesFrom>
            </owl:Restriction>
        </owl:intersectionOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_attribute"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Era_1830_1918"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="http://bimerr.iot.linkeddata.es/def/building#Building"/>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_construction_year"/>
                <owl:someValuesFrom>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description>
                                <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1919</xsd:minInclusive>
                            </rdf:Description>
                            <rdf:Description>
                                <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1945</xsd:maxInclusive>
                            </rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:someValuesFrom>
            </owl:Restriction>
        </owl:intersectionOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_attribute"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#From_1919_to_1945"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="http://bimerr.iot.linkeddata.es/def/building#Building"/>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_construction_year"/>
                <owl:someValuesFrom>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description>
                                <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1946</xsd:minInclusive>
                            </rdf:Description>
                            <rdf:Description>
                                <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1975</xsd:maxInclusive>
                            </rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:someValuesFrom>
            </owl:Restriction>
        </owl:intersectionOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_attribute"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Post_WWII"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="http://bimerr.iot.linkeddata.es/def/building#Building"/>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_construction_year"/>

    <!-- https://w3id.org/rooftop_activation#Stormwater_management_function -->

    <owl:NamedIndividual rdf:about="https://w3id.org/rooftop_activation#Stormwater_management_function">
        <rdf:type rdf:resource="https://w3id.org/rooftop_activation#Rooftop_Function"/>
        <rdfs:comment xml:lang="en">Capturing and slowing down stormwater on the rooftop to reduce peak runoff into the drainage system. Realises the blue activation type.</rdfs:comment>
        <rdfs:label xml:lang="en">Stormwater management function</rdfs:label>
    </owl:NamedIndividual>
    



    <!-- https://w3id.org/rooftop_activation#Bond -->

    <owl:NamedIndividual rdf:about="https://w3id.org/rooftop_activation#Bond"/>
    


    <!-- https://w3id.org/rooftop_activation#Brussels -->

    <owl:NamedIndividual rdf:about="https://w3id.org/rooftop_activation#Brussels">
        <rdf:type rdf:resource="https://w3id.org/rooftop_activation#Region"/>
        <rdfs:comment xml:lang="en">The Brussels-Capital Region, Belgium, used as the geographic scope for the incentives it implements.</rdfs:comment>
        <rdfs:label xml:lang="en">Brussels</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rooftop_activation#Call_for_Projects_or_Competitive_Grant -->


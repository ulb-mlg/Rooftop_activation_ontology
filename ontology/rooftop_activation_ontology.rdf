    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/rooftop_activation#applies_at_stage -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rooftop_activation#applies_at_stage">
        <rdfs:domain rdf:resource="https://w3id.org/rooftop_activation#Incentive"/>
        <rdfs:range rdf:resource="https://w3id.org/rooftop_activation#Project_Stage"/>
        <rdfs:comment xml:lang="en">Relates an incentive to the project stage at which it acts: pre-investment, investment or operation. An incentive may apply at more than one stage.</rdfs:comment>
        <rdfs:label xml:lang="en">applies at stage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rooftop_activation#classifies_rooftop -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rooftop_activation#classifies_rooftop">
        <owl:inverseOf rdf:resource="https://w3id.org/rooftop_activation#has_rooftop_type"/>
        <rdfs:domain rdf:resource="https://w3id.org/rooftop_activation#Rooftop_Type"/>
        <rdfs:range rdf:resource="https://w3id.org/rooftop_activation#Rooftop"/>
        <rdfs:comment xml:lang="en">Relates a rooftop type to the rooftops it classifies. Inverse of has_rooftop_type.</rdfs:comment>
        <rdfs:label xml:lang="en">classifies rooftop</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rooftop_activation#contains_building -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rooftop_activation#contains_building">
        <owl:inverseOf rdf:resource="https://w3id.org/rooftop_activation#is_located_in"/>
        <rdfs:domain rdf:resource="https://w3id.org/rooftop_activation#District"/>
        <rdfs:range rdf:resource="http://bimerr.iot.linkeddata.es/def/building#Building"/>
        <rdfs:comment xml:lang="en">Relates a district to the buildings located in it. Inverse of is_located_in.</rdfs:comment>
        <rdfs:label xml:lang="en">contains building</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rooftop_activation#defined_for_region -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rooftop_activation#defined_for_region">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rooftop_activation#Association"/>
        <rdfs:range rdf:resource="https://w3id.org/rooftop_activation#Region"/>
        <rdfs:comment xml:lang="en">The region whose authority defined the association. If absent, the association applies to all regions.</rdfs:comment>
        <rdfs:label xml:lang="en">defined for region</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rooftop_activation#has_allocation_mechanism -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rooftop_activation#has_allocation_mechanism">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rooftop_activation#Incentive"/>
        <rdfs:range rdf:resource="https://w3id.org/rooftop_activation#Allocation_Mechanism"/>
        <rdfs:comment xml:lang="en">Relates an incentive to the mechanism by which it is allocated to recipients: competitive, entitlement, first-come or negotiated. Functional: an incentive has at most one allocation mechanism.</rdfs:comment>
        <rdfs:label xml:lang="en">has allocation mechanism</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rooftop_activation#has_attribute -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rooftop_activation#has_attribute">
        <owl:inverseOf rdf:resource="https://w3id.org/rooftop_activation#is_attribute_of"/>
        <rdfs:domain rdf:resource="http://bimerr.iot.linkeddata.es/def/building#Building"/>
        <rdfs:range rdf:resource="https://w3id.org/rooftop_activation#Building_Attribute"/>
        <rdfs:comment xml:lang="en">Relates a building to a characteristic that constrains or enables rooftop activation. Inverse of is_attribute_of.</rdfs:comment>
        <rdfs:label xml:lang="en">has attribute</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rooftop_activation#has_density -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rooftop_activation#has_density">
        <rdfs:domain rdf:resource="https://w3id.org/rooftop_activation#District"/>
        <rdfs:range rdf:resource="https://w3id.org/rooftop_activation#Urban_Density"/>
        <rdfs:comment xml:lang="en">Relates a district to its built-form intensity.</rdfs:comment>
        <rdfs:label xml:lang="en">has density</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rooftop_activation#has_district_urban_challenge_priority -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rooftop_activation#has_district_urban_challenge_priority">
        <owl:inverseOf rdf:resource="https://w3id.org/rooftop_activation#has_urban_challenge_district_priority"/>
        <rdfs:domain rdf:resource="https://w3id.org/rooftop_activation#District"/>
        <rdfs:range rdf:resource="https://w3id.org/rooftop_activation#Urban_Challenge"/>
        <rdfs:comment xml:lang="en">Relates a district to the urban challenges most pressing within it. Inverse of has_urban_challenge_district_priority.</rdfs:comment>
        <rdfs:label xml:lang="en">has district urban challenge priority</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rooftop_activation#has_function -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rooftop_activation#has_function">
        <owl:inverseOf rdf:resource="https://w3id.org/rooftop_activation#is_done_in"/>
        <rdfs:domain rdf:resource="https://w3id.org/rooftop_activation#Rooftop"/>
        <rdfs:range rdf:resource="https://w3id.org/rooftop_activation#Rooftop_Function"/>
        <rdfs:comment xml:lang="en">Relates a rooftop to the activities performed on it. Inverse of is_done_in.</rdfs:comment>
        <rdfs:label xml:lang="en">has function</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rooftop_activation#has_funding_source -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rooftop_activation#has_funding_source">
        <rdfs:domain rdf:resource="https://w3id.org/rooftop_activation#Incentive"/>
        <rdfs:range rdf:resource="https://w3id.org/rooftop_activation#Funding_Source"/>
        <rdfs:comment xml:lang="en">Relates an incentive to the source of the resources that fund it: community, private or public. An incentive may combine several sources.</rdfs:comment>
        <rdfs:label xml:lang="en">has funding source</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rooftop_activation#has_incentive_function -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rooftop_activation#has_incentive_function">
        <rdfs:domain rdf:resource="https://w3id.org/rooftop_activation#Incentive"/>
        <rdfs:range rdf:resource="https://w3id.org/rooftop_activation#Incentive_Function"/>
        <rdfs:comment xml:lang="en">Relates an incentive to the effect it has on an owner&apos;s decision to activate a rooftop, such as reducing up-front costs, de-risking or raising additional capital. An incentive may have more than one function.</rdfs:comment>
        <rdfs:label xml:lang="en">has incentive function</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rooftop_activation#has_incentive_nature -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rooftop_activation#has_incentive_nature">
        <rdfs:domain rdf:resource="https://w3id.org/rooftop_activation#Incentive"/>
        <rdfs:range rdf:resource="https://w3id.org/rooftop_activation#Incentive_Nature"/>
        <rdfs:comment xml:lang="en">Relates an incentive to the kind of lever it uses: contractual, financial, informational, organisational or regulatory. An incentive may have more than one nature.</rdfs:comment>
        <rdfs:label xml:lang="en">has incentive nature</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rooftop_activation#has_main_function -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rooftop_activation#has_main_function">
        <owl:inverseOf rdf:resource="https://w3id.org/rooftop_activation#is_mainly_used_in"/>
        <rdfs:domain rdf:resource="https://w3id.org/rooftop_activation#District"/>
        <rdfs:range rdf:resource="https://w3id.org/rooftop_activation#District_Function"/>
        <rdfs:comment xml:lang="en">Relates a district to its dominant land use. Inverse of is_mainly_used_in.</rdfs:comment>
        <rdfs:label xml:lang="en">has main function</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rooftop_activation#has_obligation_attachment -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rooftop_activation#has_obligation_attachment">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rooftop_activation#Incentive"/>
        <rdfs:range rdf:resource="https://w3id.org/rooftop_activation#Obligation_Attachment"/>
        <rdfs:comment xml:lang="en">Relates an incentive to what its benefits and obligations are attached to: the person, the project or the property. Functional: an incentive has at most one obligation attachment.</rdfs:comment>
        <rdfs:label xml:lang="en">has obligation attachment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rooftop_activation#has_owner_urban_challenge_priority -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rooftop_activation#has_owner_urban_challenge_priority">
        <owl:inverseOf rdf:resource="https://w3id.org/rooftop_activation#has_urban_challenge_owner_priority"/>
        <rdfs:domain rdf:resource="https://w3id.org/rooftop_activation#Owner"/>
        <rdfs:range rdf:resource="https://w3id.org/rooftop_activation#Urban_Challenge"/>
        <rdfs:comment xml:lang="en">Relates an owner to the urban challenges they prioritise, used to match incentives and activation types to owner motivation. Inverse of has_urban_challenge_owner_priority.</rdfs:comment>
        <rdfs:label xml:lang="en">has owner urban challenge priority</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rooftop_activation#has_rooftop -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rooftop_activation#has_rooftop">
        <owl:inverseOf rdf:resource="https://w3id.org/rooftop_activation#is_part_of"/>
        <rdfs:domain rdf:resource="http://bimerr.iot.linkeddata.es/def/building#Building"/>
        <rdfs:range rdf:resource="https://w3id.org/rooftop_activation#Rooftop"/>
        <rdfs:comment xml:lang="en">Relates a building to the rooftops it carries. Inverse of is_part_of.</rdfs:comment>
        <rdfs:label xml:lang="en">has rooftop</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rooftop_activation#has_rooftop_type -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rooftop_activation#has_rooftop_type">
        <rdfs:domain rdf:resource="https://w3id.org/rooftop_activation#Rooftop"/>
        <rdfs:range rdf:resource="https://w3id.org/rooftop_activation#Rooftop_Type"/>
        <rdfs:comment xml:lang="en">Relates a rooftop to its geometric classification. Inverse of classifies_rooftop</rdfs:comment>
        <rdfs:label xml:lang="en">has rooftop type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rooftop_activation#has_urban_challenge_district_priority -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rooftop_activation#has_urban_challenge_district_priority">
        <rdfs:domain rdf:resource="https://w3id.org/rooftop_activation#Urban_Challenge"/>
        <rdfs:range rdf:resource="https://w3id.org/rooftop_activation#District"/>
        <rdfs:comment xml:lang="en">Inverse of has_district_urban_challenge_priority.</rdfs:comment>
        <rdfs:label xml:lang="en">has urban challenge district priority</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rooftop_activation#has_urban_challenge_owner_priority -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rooftop_activation#has_urban_challenge_owner_priority">
        <rdfs:domain rdf:resource="https://w3id.org/rooftop_activation#Urban_Challenge"/>
        <rdfs:range rdf:resource="https://w3id.org/rooftop_activation#Owner"/>
        <rdfs:comment xml:lang="en">Inverse of has_owner_urban_challenge_priority.</rdfs:comment>
        <rdfs:label xml:lang="en">has urban challenge owner priority</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rooftop_activation#implemented_in -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rooftop_activation#implemented_in">
        <owl:inverseOf rdf:resource="https://w3id.org/rooftop_activation#implements"/>
        <rdfs:domain rdf:resource="https://w3id.org/rooftop_activation#Incentive"/>
        <rdfs:range rdf:resource="https://w3id.org/rooftop_activation#Region"/>
        <rdfs:comment xml:lang="en">Relation that states that an incentive is implemented in a region to activate a rooftop.</rdfs:comment>
        <rdfs:label xml:lang="en">implemented in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rooftop_activation#implements -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rooftop_activation#implements">
        <rdfs:domain rdf:resource="https://w3id.org/rooftop_activation#Region"/>
        <rdfs:range rdf:resource="https://w3id.org/rooftop_activation#Incentive"/>
        <rdfs:comment xml:lang="en">Relation that states that a region implements an incentive to activate a rooftop. The inverse is implemented_in.</rdfs:comment>
        <rdfs:label xml:lang="en">implements</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rooftop_activation#incentive_associated_to_rooftop -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rooftop_activation#incentive_associated_to_rooftop">
        <owl:inverseOf rdf:resource="https://w3id.org/rooftop_activation#rooftop_associated_to_incentive"/>
        <rdfs:domain rdf:resource="https://w3id.org/rooftop_activation#Incentive"/>
        <rdfs:range rdf:resource="https://w3id.org/rooftop_activation#Rooftop"/>
        <rdfs:comment xml:lang="en">Relates an incentive to the rooftop types it supports or funds. Inverse of rooftop_associated_to_incentive.</rdfs:comment>
        <rdfs:label xml:lang="en">incentive associated to rooftop</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rooftop_activation#includes_districts -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rooftop_activation#includes_districts">
        <owl:inverseOf rdf:resource="https://w3id.org/rooftop_activation#is_part_of_region"/>
        <rdfs:domain rdf:resource="https://w3id.org/rooftop_activation#Region"/>
        <rdfs:range rdf:resource="https://w3id.org/rooftop_activation#District"/>
        <rdfs:comment xml:lang="en">Relates a region to the districts it contains. Inverse of is_part_of_region.</rdfs:comment>
        <rdfs:label xml:lang="en">includes districts</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rooftop_activation#is_attribute_of -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rooftop_activation#is_attribute_of">
        <rdfs:domain rdf:resource="https://w3id.org/rooftop_activation#Building_Attribute"/>
        <rdfs:range rdf:resource="http://bimerr.iot.linkeddata.es/def/building#Building"/>
        <rdfs:comment xml:lang="en">Relates a building attribute to the building it characterises. Inverse of has_attribute.</rdfs:comment>
        <rdfs:label xml:lang="en">is attribute of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rooftop_activation#is_done_in -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rooftop_activation#is_done_in">
        <rdfs:domain rdf:resource="https://w3id.org/rooftop_activation#Rooftop_Function"/>
        <rdfs:range rdf:resource="https://w3id.org/rooftop_activation#Rooftop"/>
        <rdfs:comment xml:lang="en">Relates a rooftop function to the rooftops where it is performed. Inverse of has_function.</rdfs:comment>
        <rdfs:label xml:lang="en">is done in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rooftop_activation#is_located_in -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rooftop_activation#is_located_in">
        <rdfs:domain rdf:resource="http://bimerr.iot.linkeddata.es/def/building#Building"/>
        <rdfs:range rdf:resource="https://w3id.org/rooftop_activation#District"/>
        <rdfs:comment xml:lang="en">Relates a building to the district in which it is located. Inverse of contains_building.</rdfs:comment>
        <rdfs:label xml:lang="en">is located in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rooftop_activation#is_mainly_used_in -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rooftop_activation#is_mainly_used_in">
        <rdfs:domain rdf:resource="https://w3id.org/rooftop_activation#District_Function"/>
        <rdfs:range rdf:resource="https://w3id.org/rooftop_activation#District"/>
        <rdfs:comment xml:lang="en">Relates a district function to the districts where it dominates. Inverse of has_main_function.</rdfs:comment>
        <rdfs:label xml:lang="en">is mainly used in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rooftop_activation#is_owned_by -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rooftop_activation#is_owned_by">
        <owl:inverseOf rdf:resource="https://w3id.org/rooftop_activation#owns"/>
        <rdfs:domain rdf:resource="http://bimerr.iot.linkeddata.es/def/building#Building"/>
        <rdfs:range rdf:resource="https://w3id.org/rooftop_activation#Owner"/>
        <rdfs:comment xml:lang="en">Relates a building to the party holding decision rights over it. Inverse of owns.</rdfs:comment>
        <rdfs:label xml:lang="en">is owned by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rooftop_activation#is_part_of -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rooftop_activation#is_part_of">
        <rdfs:domain rdf:resource="https://w3id.org/rooftop_activation#Rooftop"/>
        <rdfs:range rdf:resource="http://bimerr.iot.linkeddata.es/def/building#Building"/>
        <rdfs:comment xml:lang="en">Relates a rooftop to the building it belongs to. Inverse of has_rooftop.</rdfs:comment>
        <rdfs:label xml:lang="en">is part of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rooftop_activation#is_part_of_region -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rooftop_activation#is_part_of_region">
        <rdfs:domain rdf:resource="https://w3id.org/rooftop_activation#District"/>
        <rdfs:range rdf:resource="https://w3id.org/rooftop_activation#Region"/>
        <rdfs:comment xml:lang="en">Relates a district to the region it forms part of. Inverse of includes_districts.</rdfs:comment>
        <rdfs:label xml:lang="en">is part of region</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rooftop_activation#owns -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rooftop_activation#owns">
        <rdfs:domain rdf:resource="https://w3id.org/rooftop_activation#Owner"/>
        <rdfs:range rdf:resource="http://bimerr.iot.linkeddata.es/def/building#Building"/>
        <rdfs:comment xml:lang="en">Relates an owner to the buildings under their control. Inverse of is_owned_by.</rdfs:comment>
        <rdfs:label xml:lang="en">owns</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rooftop_activation#relates_challenge -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rooftop_activation#relates_challenge">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rooftop_activation#Association"/>
        <rdfs:range rdf:resource="https://w3id.org/rooftop_activation#Urban_Challenge"/>
        <rdfs:comment xml:lang="en">The urban challenge involved in the association.</rdfs:comment>
        <rdfs:label xml:lang="en">relates challenge</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rooftop_activation#relates_incentive_type -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rooftop_activation#relates_incentive_type">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rooftop_activation#Association"/>
        <rdfs:comment xml:lang="en">The incentive type (Incentive subclass) involved in the association. The value is the class IRI used as an individual (OWL 2 punning).</rdfs:comment>
        <rdfs:label xml:lang="en">relates incentive type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rooftop_activation#relates_owner_type -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rooftop_activation#relates_owner_type">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rooftop_activation#Association"/>
        <rdfs:comment xml:lang="en">The owner type (Owner subclass) involved in the association. The value is the class IRI used as an individual (OWL 2 punning).</rdfs:comment>
        <rdfs:label xml:lang="en">relates owner type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rooftop_activation#relates_rooftop_type -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rooftop_activation#relates_rooftop_type">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rooftop_activation#Association"/>
        <rdfs:comment xml:lang="en">The rooftop activation type (colour class) involved in the association. The value is the class IRI used as an individual (OWL 2 punning).</rdfs:comment>
        <rdfs:label xml:lang="en">relates rooftop type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rooftop_activation#rooftop_associated_to_incentive -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rooftop_activation#rooftop_associated_to_incentive">
        <rdfs:domain rdf:resource="https://w3id.org/rooftop_activation#Rooftop"/>
        <rdfs:range rdf:resource="https://w3id.org/rooftop_activation#Incentive"/>
        <rdfs:comment xml:lang="en">Inverse of incentive_associated_to_rooftop.</rdfs:comment>
        <rdfs:label xml:lang="en">rooftop associated to incentive</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/rooftop_activation#has_city_model_id -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rooftop_activation#has_city_model_id">
        <rdfs:domain rdf:resource="http://bimerr.iot.linkeddata.es/def/building#Building"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The identifier of the building in a CityJSON city model, that is, the key of the Building or BuildingPart in the CityObjects of the file.</rdfs:comment>
        <rdfs:label xml:lang="en">has city model id</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rooftop_activation#has_construction_year -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rooftop_activation#has_construction_year">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://bimerr.iot.linkeddata.es/def/building#Building"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">The year in which the building was constructed, expressed as an integer. The construction era attribute of the building is derived from it automatically.</rdfs:comment>
        <rdfs:label xml:lang="en">has construction year</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rooftop_activation#has_degree -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rooftop_activation#has_degree">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rooftop_activation#Association"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</xsd:minInclusive>
                    </rdf:Description>
                    <rdf:Description>
                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</xsd:maxInclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Strength of the association, from 0 (none) to 1 (strongest).</rdfs:comment>
        <rdfs:label xml:lang="en">has degree</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rooftop_activation#has_incentive_description -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rooftop_activation#has_incentive_description">
        <rdfs:domain rdf:resource="https://w3id.org/rooftop_activation#Incentive"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A free-text description of an incentive, summarising its purpose, eligibility conditions and main features.</rdfs:comment>
        <rdfs:label xml:lang="en">has incentive description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rooftop_activation#has_osm_element -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rooftop_activation#has_osm_element">
        <rdfs:domain rdf:resource="http://bimerr.iot.linkeddata.es/def/building#Building"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">Links a building to the OpenStreetMap way or relation that represents it, as a full openstreetmap.org URL. OSM identifiers may change, so the geometry should also be kept.</rdfs:comment>
        <rdfs:label xml:lang="en">has OSM element</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://bimerr.iot.linkeddata.es/def/building#Building -->

    <owl:Class rdf:about="http://bimerr.iot.linkeddata.es/def/building#Building">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasDefaultGeometry"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_attribute"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/rooftop_activation#Construction_Era_and_Typology"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A physical structure with one or more rooftops, owned by an Owner and characterised by a set of Building_Attributes. A building is a GeoSPARQL feature. Its geographic position is given by a geometry linked through geo:hasDefaultGeometry, normally its footprint as a WKT polygon, and optionally by a point linked through geo:hasCentroid. A building can be linked to its OpenStreetMap element through has_osm_element and to its city object in a CityJSON model through has_city_model_id.</rdfs:comment>
        <rdfs:label xml:lang="en">Building</rdfs:label>
    </owl:Class>
    


    <!-- http://bimerr.iot.linkeddata.es/def/building#Roof -->

    <owl:Class rdf:about="http://bimerr.iot.linkeddata.es/def/building#Roof">
        <rdfs:comment xml:lang="en">The upper covering of a building. Superclass of Rooftop.</rdfs:comment>
        <rdfs:label xml:lang="en">Roof</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/org#Organization -->

    <owl:Class rdf:about="http://www.w3.org/ns/org#Organization">
        <rdfs:comment xml:lang="en">A legal or social body of people used to represent the affiliation of the people working with this ontology</rdfs:comment>
        <rdfs:label>Organization</rdfs:label>
    </owl:Class>
    


    <!-- http://xmlns.com/foaf/0.1/Person -->

    <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Person">
        <rdfs:comment xml:lang="en">An individual human being used to describe people interacting with this ontology</rdfs:comment>
        <rdfs:label xml:lang="en">Person</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Access_Regulation -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Access_Regulation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Regulatory_Constraint"/>
        <rdfs:comment xml:lang="en">Requirements on how a rooftop may be reached and by whom, governing public and semi-public use.</rdfs:comment>
        <rdfs:label xml:lang="en">Access Regulation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Advisory_Service -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Advisory_Service">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Informational_Instrument"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#applies_at_stage"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Pre-investment_Stage"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_incentive_function"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Building_Capacity_or_Awareness"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Affordable_Housing_Challenge -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Affordable_Housing_Challenge">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Urban_Challenge"/>
        <rdfs:comment xml:lang="en">Difficulty in providing enough suitable housing at affordable cost, including shortages, mismatches between supply and needs, and heritage restrictions on transformation.</rdfs:comment>
        <rdfs:label xml:lang="en">Affordable Housing Challenge</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Aging_Unfit_or_Fragile_Infrastructure_Challenge -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Aging_Unfit_or_Fragile_Infrastructure_Challenge">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Urban_Challenge"/>
        <rdfs:comment xml:lang="en">Water, energy and transport networks that are outdated, lack capacity for new demands such as electric vehicle charging, or are constrained by heritage protection.</rdfs:comment>
        <rdfs:label xml:lang="en">Aging Unfit or Fragile Infrastructure Challenge</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Allocation_Mechanism -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Allocation_Mechanism">
        <rdfs:comment xml:lang="en">Facet capturing how access to an incentive is decided among applicants, which drives the certainty and effort of obtaining it. Functional: an incentive uses at most one mechanism. Used with has_allocation_mechanism.</rdfs:comment>
        <rdfs:label xml:lang="en">Allocation Mechanism</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Association -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Association">
        <rdfs:comment xml:lang="en">A weighted link between two types of the ontology, expressed as an individual so that it can carry a degree.</rdfs:comment>
        <rdfs:label xml:lang="en">Association</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Attached_to_Person -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Attached_to_Person">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Obligation_Attachment"/>
        <rdfs:comment xml:lang="en">Follows the individual or legal entity. Ends or moves with them if the property changes hands.</rdfs:comment>
        <rdfs:label xml:lang="en">Attached to Person</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Attached_to_Project -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Attached_to_Project">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Obligation_Attachment"/>
        <rdfs:comment xml:lang="en">Tied to a defined intervention and its delivery, ending when the project ends.</rdfs:comment>
        <rdfs:label xml:lang="en">Attached to Project</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Attached_to_Property -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Attached_to_Property">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Obligation_Attachment"/>
        <rdfs:comment xml:lang="en">Follows the building or parcel. Transfers automatically to the next owner or occupant.</rdfs:comment>
        <rdfs:label xml:lang="en">Attached to Property</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Blended_Finance_Program -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Blended_Finance_Program">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Grant"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_funding_source"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Private_Source"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_funding_source"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Public_Source"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Blue_Rooftop -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Blue_Rooftop">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_function"/>
                        <owl:hasValue rdf:resource="https://w3id.org/rooftop_activation#Stormwater_management_function"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_function"/>
                        <owl:hasValue rdf:resource="https://w3id.org/rooftop_activation#Water_retention_function"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Rooftop"/>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Bond -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Bond">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Debt_instrument"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#applies_at_stage"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Investment_Stage"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/rooftop_activation#Loan"/>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Brick -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Brick">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Building_Material"/>
        <rdfs:comment xml:lang="en">Buildings whose dominant construction material is the one named.</rdfs:comment>
        <rdfs:label xml:lang="en">Brick</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Building_Attribute -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Building_Attribute">
        <owl:disjointWith rdf:resource="https://w3id.org/rooftop_activation#District"/>
        <rdfs:comment xml:lang="en">A characteristic of a building that constrains or enables rooftop activation. Attributes are grouped into independent facets: material, era, construction method, height, location, primary use and regulatory constraint.</rdfs:comment>
        <rdfs:label xml:lang="en">Building Attribute</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Building_Capacity_or_Awareness -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Building_Capacity_or_Awareness">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Incentive_Function"/>
        <rdfs:comment xml:lang="en">Increases the knowledge, skills or motivation of owners and intermediaries.</rdfs:comment>
        <rdfs:label xml:lang="en">Building Capacity or Awareness</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Building_Material -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Building_Material">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Building_Attribute"/>
        <rdfs:comment xml:lang="en">The dominant structural or envelope material of a building, which affects load capacity, thermal behaviour and retrofit options.</rdfs:comment>
        <rdfs:label xml:lang="en">Building Material</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Call_for_Projects_or_Competitive_Grant -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Call_for_Projects_or_Competitive_Grant">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Grant"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_allocation_mechanism"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Competitive_Allocation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Citizen_Micro-investment_Tax_Credit -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Citizen_Micro-investment_Tax_Credit">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Tax_Credit"/>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#City_Center -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#City_Center">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#District"/>
        <rdfs:comment xml:lang="en">The historic and functional core, with the highest density and the strongest heritage constraints.</rdfs:comment>
        <rdfs:label xml:lang="en">City Center</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Climate_Adaptation_and_Resilience_Challenge -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Climate_Adaptation_and_Resilience_Challenge">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Urban_Challenge"/>
        <rdfs:comment xml:lang="en">Exposure of the city to climate impacts such as flooding, heat, drought and water scarcity, and the need to improve water management.</rdfs:comment>
        <rdfs:label xml:lang="en">Climate Adaptation and Resilience Challenge</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Commercial_Use -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Commercial_Use">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Primary_Use"/>
        <rdfs:comment xml:lang="en">Retail, hospitality and other trading activity.</rdfs:comment>
        <rdfs:label xml:lang="en">Commercial Use</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Community_Source -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Community_Source">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Funding_Source"/>
        <rdfs:comment xml:lang="en">Resources pooled from citizens, cooperatives or civil society organisations.</rdfs:comment>
        <rdfs:label xml:lang="en">Community Source</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Competitive_Allocation -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Competitive_Allocation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Allocation_Mechanism"/>
        <rdfs:comment xml:lang="en">Applications are ranked or selected against criteria, with no guarantee of award.</rdfs:comment>
        <rdfs:label xml:lang="en">Competitive Allocation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Competitive_Incentive -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Competitive_Incentive">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Incentive"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_allocation_mechanism"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Competitive_Allocation"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Incentive"/>
        <rdfs:comment xml:lang="en">An incentive allocated through a competitive procedure, where applicants are ranked or selected against criteria. Defined class: membership is inferred from has_allocation_mechanism.</rdfs:comment>
        <rdfs:label xml:lang="en">Competitive Incentive</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Concrete -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Concrete">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Building_Material"/>
        <rdfs:comment xml:lang="en">Buildings whose dominant construction material is the one named.</rdfs:comment>
        <rdfs:label xml:lang="en">Concrete</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Construction_Era_and_Typology -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Construction_Era_and_Typology">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Building_Attribute"/>
        <owl:disjointUnionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Era_1830_1918"/>
            <rdf:Description rdf:about="https://w3id.org/rooftop_activation#From_1919_to_1945"/>
            <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Late_20th_Century"/>
            <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Post_WWII"/>
            <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Pre_1830"/>
            <rdf:Description rdf:about="https://w3id.org/rooftop_activation#21st_Century"/>
        </owl:disjointUnionOf>
        <rdfs:comment xml:lang="en">The period in which a building was constructed, used as a proxy for structural standards, insulation levels and heritage status. The era of a building is derived from its construction year through has_construction_year, so it does not need to be asserted.</rdfs:comment>
        <rdfs:label xml:lang="en">Construction Era and Typology</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Construction_Method -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Construction_Method">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Building_Attribute"/>
        <rdfs:comment xml:lang="en">How a building was assembled, which determines the predictability of its structural capacity.</rdfs:comment>
        <rdfs:label xml:lang="en">Construction Method</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Contractual_Condition -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Contractual_Condition">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Contractual_or_Governance_Instrument"/>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Contractual_Nature -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Contractual_Nature">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Incentive_Nature"/>
        <rdfs:comment xml:lang="en">Operates through an agreement negotiated between parties, with obligations and remedies defined in the contract itself.</rdfs:comment>
        <rdfs:label xml:lang="en">Contractual Nature</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Contractual_or_Governance_Incentive -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Contractual_or_Governance_Incentive">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Incentive"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_incentive_nature"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Contractual_Nature"/>
                                    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Organizational_Nature"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Incentive"/>
        <rdfs:comment xml:lang="en">An incentive with a contractual or organisational nature, acting through agreements between parties or through structures and governance arrangements. Defined class: membership is inferred from has_incentive_nature.</rdfs:comment>
        <rdfs:label xml:lang="en">Contractual or Governance Incentive</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Contractual_or_Governance_Instrument -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Contractual_or_Governance_Instrument">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Incentive"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_allocation_mechanism"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Negotiated_Allocation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_incentive_nature"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Contractual_Nature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Coordinating_Actors -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Coordinating_Actors">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Incentive_Function"/>
        <rdfs:comment xml:lang="en">Aligns the decisions of multiple parties, typically through planning, programming or governance arrangements.</rdfs:comment>
        <rdfs:label xml:lang="en">Coordinating Actors</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Crowdfunding_Crowdlending_and_Crowd_Equity -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Crowdfunding_Crowdlending_and_Crowd_Equity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Equity_or_Collective_Finance_Instrument"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_funding_source"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Community_Source"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/rooftop_activation#Fund"/>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Crowdsourcing -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Crowdsourcing">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Use_or_Access_Instrument"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_incentive_nature"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Organizational_Nature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Cultural_and_Leisure_Use -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Cultural_and_Leisure_Use">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Primary_Use"/>
        <rdfs:comment xml:lang="en">Museums, theatres, sports and recreation facilities.</rdfs:comment>
        <rdfs:label xml:lang="en">Cultural and Leisure Use</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#De-risking -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#De-risking">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Incentive_Function"/>
        <rdfs:comment xml:lang="en">Transfers or absorbs part of the project&apos;s technical, financial or performance risk.</rdfs:comment>
        <rdfs:label xml:lang="en">De-risking</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Debt_instrument -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Debt_instrument">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Incentive"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_incentive_nature"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Financial_Nature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Decarbonizing_Energy_Systems_Challenge -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Decarbonizing_Energy_Systems_Challenge">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Urban_Challenge"/>
        <rdfs:comment xml:lang="en">The need to cut greenhouse gas emissions from energy use by adopting renewable sources, improving building efficiency and adding storage and low-carbon heat.</rdfs:comment>
        <rdfs:label xml:lang="en">Decarbonizing Energy Systems Challenge</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Developer_or_Charge_Fee -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Developer_or_Charge_Fee">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Contractual_or_Governance_Instrument"/>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Digital_Platform_Service -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Digital_Platform_Service">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Tools"/>
        <owl:disjointWith rdf:resource="https://w3id.org/rooftop_activation#Mapping_Tools"/>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Direct_Transfer_Instrument -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Direct_Transfer_Instrument">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Incentive"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_incentive_nature"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Financial_Nature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Disclosure -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Disclosure">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Regulatory_Instrument"/>
        <owl:disjointWith rdf:resource="https://w3id.org/rooftop_activation#Regulation"/>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#District -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#District">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:comment xml:lang="en">A delimited part of a city or its surroundings with a characteristic built form, density and function. Buildings are linked to districts through is_located_in, and districts to regions through is_part_of_region.</rdfs:comment>
        <rdfs:label xml:lang="en">District</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#District_Function -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#District_Function">
        <rdfs:comment xml:lang="en">The dominant land use of a district, as distinct from the primary use of an individual building.</rdfs:comment>
        <rdfs:label xml:lang="en">District Function</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#ESCO_or_Sustainability_Agreement -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#ESCO_or_Sustainability_Agreement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Contractual_or_Governance_Instrument"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_incentive_nature"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Financial_Nature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_obligation_attachment"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Attached_to_Property"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Entitlement_Allocation -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Entitlement_Allocation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Allocation_Mechanism"/>
        <rdfs:comment xml:lang="en">Any applicant meeting the stated conditions receives the incentive automatically.</rdfs:comment>
        <rdfs:label xml:lang="en">Entitlement Allocation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Equity_or_Collective_Finance_Instrument -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Equity_or_Collective_Finance_Instrument">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Incentive"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_incentive_function"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Raising_Additional_Capital"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_incentive_nature"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Financial_Nature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Era_1830_1918 -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Era_1830_1918">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Construction_Era_and_Typology"/>
        <rdfs:comment xml:lang="en">Early industrial-era construction, masonry-dominated, often with heritage constraints (1830-1918).</rdfs:comment>
        <rdfs:label xml:lang="en">1830 - 1918</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#European_Grant -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#European_Grant">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Grant"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_funding_source"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#European_Source"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Incentive"/>
        <rdfs:comment xml:lang="en">A grant funded, fully or partly, by European Union resources. Defined class: membership is inferred from has_funding_source.</rdfs:comment>
        <rdfs:label xml:lang="en">European Grant</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#European_Incentive -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#European_Incentive">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Incentive"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_funding_source"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#European_Source"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Incentive"/>
        <rdfs:comment xml:lang="en">An incentive funded, fully or partly, by European Union resources. Defined class: membership is inferred from has_funding_source.</rdfs:comment>
        <rdfs:label xml:lang="en">European Incentive</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#European_Source -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#European_Source">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Public_Source"/>
        <rdfs:comment xml:lang="en">Public resources originating in European Union programmes, funds or institutions.</rdfs:comment>
        <rdfs:label xml:lang="en">European Source</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Feed-in_Tariff -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Feed-in_Tariff">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Subsidy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#applies_at_stage"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Operation_Stage"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_incentive_function"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Improving_Operating_Economics"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Financial_Incentive -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Financial_Incentive">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Incentive"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_incentive_nature"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Financial_Nature"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Incentive"/>
        <rdfs:comment xml:lang="en">An incentive with at least one financial nature, that is, one that operates by moving money or altering the cost of capital. Defined class: membership is inferred from has_incentive_nature.</rdfs:comment>
        <rdfs:label xml:lang="en">Financial Incentive</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Financial_Nature -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Financial_Nature">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Incentive_Nature"/>
        <rdfs:comment xml:lang="en">Operates by moving money or altering the cost of capital.</rdfs:comment>
        <rdfs:label xml:lang="en">Financial Nature</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Fire_Safety_Regulation -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Fire_Safety_Regulation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Regulatory_Constraint"/>
        <rdfs:comment xml:lang="en">Requirements on escape routes, compartmentation and material behaviour that affect rooftop occupancy.</rdfs:comment>
        <rdfs:label xml:lang="en">Fire Safety Regulation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#First-come_Allocation -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#First-come_Allocation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Allocation_Mechanism"/>
        <rdfs:comment xml:lang="en">Applications are granted in order of receipt until a budget or quota is exhausted.</rdfs:comment>
        <rdfs:label xml:lang="en">First-come Allocation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Fiscal_Instrument -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Fiscal_Instrument">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Incentive"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_incentive_nature"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Fiscal_Nature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Fiscal_Measure -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Fiscal_Measure">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Fiscal_Instrument"/>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Fiscal_Nature -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Fiscal_Nature">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Financial_Nature"/>
        <rdfs:comment xml:lang="en">A financial nature exercised through the tax system, including credits, deductions, exemptions and rate reductions.</rdfs:comment>
        <rdfs:label xml:lang="en">Fiscal Nature</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Flat_Type -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Flat_Type">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Rooftop_Type"/>
        <rdfs:comment xml:lang="en">Roof with no or minimal pitch. Suitable for the widest range of activation types.</rdfs:comment>
        <rdfs:label xml:lang="en">Flat Type</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Flat_and_Pitched_Type -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Flat_and_Pitched_Type">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Rooftop_Type"/>
        <rdfs:comment xml:lang="en">Roof combining both geometries, allowing different activations on different sections.</rdfs:comment>
        <rdfs:label xml:lang="en">Flat and Pitched Type</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#From_1919_to_1945 -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#From_1919_to_1945">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Construction_Era_and_Typology"/>
        <rdfs:comment xml:lang="en">Interwar construction, introducing early reinforced concrete and standardised housing types (1919-1945).</rdfs:comment>
        <rdfs:label xml:lang="en">1919 - 1945</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Fund -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Fund">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Equity_or_Collective_Finance_Instrument"/>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Funding_Source -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Funding_Source">
        <owl:disjointUnionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Community_Source"/>
            <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Private_Source"/>
            <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Public_Source"/>
        </owl:disjointUnionOf>
        <rdfs:comment xml:lang="en">Facet capturing the origin of the resources behind an incentive. An incentive may draw on several sources, as in blended finance. Used with has_funding_source.</rdfs:comment>
        <rdfs:label xml:lang="en">Funding Source</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Funding_Vehicle -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Funding_Vehicle">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Fund"/>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Glass -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Glass">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Building_Material"/>
        <rdfs:comment xml:lang="en">Buildings whose dominant construction material is the one named.</rdfs:comment>
        <rdfs:label xml:lang="en">Glass</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Governance_Challenge -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Governance_Challenge">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Urban_Challenge"/>
        <rdfs:comment xml:lang="en">Institutional barriers such as lack of funding, fragmented competences, and missing regulatory or data frameworks for implementing urban strategies.</rdfs:comment>
        <rdfs:label xml:lang="en">Governance Challenge</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Grant -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Grant">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Direct_Transfer_Instrument"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#applies_at_stage"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Investment_Stage"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_obligation_attachment"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Attached_to_Project"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Gray_Rooftop -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Gray_Rooftop">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_function"/>
                <owl:hasValue rdf:resource="https://w3id.org/rooftop_activation#Utilities_and_infrastructure_functions"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Rooftop"/>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Green -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Green">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Residential"/>
        <rdfs:comment xml:lang="en">Residential fabric set within substantial open and planted space.</rdfs:comment>
        <rdfs:label xml:lang="en">Green residential district</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Green_Areas -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Green_Areas">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#District"/>
        <rdfs:comment xml:lang="en">Districts dominated by open and planted land.</rdfs:comment>
        <rdfs:label xml:lang="en">Green Areas</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Green_Bond -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Green_Bond">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Bond"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_funding_source"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Private_Source"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_incentive_function"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Raising_Additional_Capital"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Green_Project_Bond -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Green_Project_Bond">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Green_Bond"/>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Green_Revenue -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Green_Revenue">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Green_Bond"/>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Green_Rooftop -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Green_Rooftop">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_function"/>
                        <owl:hasValue rdf:resource="https://w3id.org/rooftop_activation#Food_production_function"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_function"/>
                        <owl:hasValue rdf:resource="https://w3id.org/rooftop_activation#Provide_vegetation_for_biodiversity_cooling_and_amenity"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Rooftop"/>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Group_Purchases_and_Collective_Project -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Group_Purchases_and_Collective_Project">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Use_or_Access_Instrument"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_incentive_function"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Reducing_Transaction_Costs"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_incentive_nature"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Organizational_Nature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Height -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Height">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Building_Attribute"/>
        <rdfs:comment xml:lang="en">The vertical scale of a building, which affects wind exposure, access logistics and visibility of the rooftop.</rdfs:comment>
        <rdfs:label xml:lang="en">Height</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Height_Regulation -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Height_Regulation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Regulatory_Constraint"/>
        <rdfs:comment xml:lang="en">Limits on total building height, restricting additions and superstructures.</rdfs:comment>
        <rdfs:label xml:lang="en">Height Regulation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#High_Density -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#High_Density">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Urban_Density"/>
        <rdfs:comment xml:lang="en">Compact fabric with minimal open space, where rooftops represent the main remaining free surface.</rdfs:comment>
        <rdfs:label xml:lang="en">High Density</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#High_Rise -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#High_Rise">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Height"/>
        <rdfs:comment xml:lang="en">Buildings above roughly eight storeys. Significant wind loads and dedicated access requirements.</rdfs:comment>
        <rdfs:label xml:lang="en">High Rise</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Historical -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Historical">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#City_Center"/>
        <owl:disjointWith rdf:resource="https://w3id.org/rooftop_activation#Modern"/>
        <rdfs:comment xml:lang="en">The protected historic fabric of the core.</rdfs:comment>
        <rdfs:label xml:lang="en">Historical city center</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Home_Owner_Associations -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Home_Owner_Associations">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/org#Organization"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Owner"/>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Housing_Corporations -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Housing_Corporations">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/org#Organization"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Owner"/>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Improving_Operating_Economics -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Improving_Operating_Economics">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Incentive_Function"/>
        <rdfs:comment xml:lang="en">Improves recurring revenue or reduces recurring cost once the rooftop is in operation.</rdfs:comment>
        <rdfs:label xml:lang="en">Improving Operating Economics</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Incentive -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Incentive">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_incentive_function"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Incentive_Function"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_incentive_nature"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Incentive_Nature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Any measure that changes an owner&apos;s decision to activate a rooftop. Subclasses of Incentive form a single taxonomy by instrument type. Function, nature, obligation attachment, funding source, allocation mechanism and project stage are represented as separate facets via object properties, not as subclasses, because they vary independently of instrument type. Disjointness is asserted only between siblings within one facet.</rdfs:comment>
        <rdfs:label xml:lang="en">Incentive</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Incentive_Function -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Incentive_Function">
        <owl:disjointUnionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Building_Capacity_or_Awareness"/>
            <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Coordinating_Actors"/>
            <rdf:Description rdf:about="https://w3id.org/rooftop_activation#De-risking"/>
            <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Improving_Operating_Economics"/>
            <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Mandating_or_Constraining"/>
            <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Raising_Additional_Capital"/>
            <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Reducing_Transaction_Costs"/>
            <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Reducing_Up-Front_Costs"/>
            <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Stimulating_Market_or_Innovation"/>
        </owl:disjointUnionOf>
        <rdfs:comment xml:lang="en">Facet capturing what an incentive does for a rooftop activation project, independent of its instrument type. Values are mutually exclusive as a partition, but an incentive may have more than one function. Used with the object property has_incentive_function.</rdfs:comment>
        <rdfs:label xml:lang="en">Incentive Function</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Incentive_Nature -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Incentive_Nature">
        <owl:disjointUnionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Contractual_Nature"/>
            <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Financial_Nature"/>
            <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Informational_Nature"/>
            <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Organizational_Nature"/>
            <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Regulatory_Nature"/>
        </owl:disjointUnionOf>
        <rdfs:comment xml:lang="en">Facet capturing the kind of lever an incentive pulls, independent of its instrument type and its function. Values partition the facet, except Fiscal_Nature which is a subclass of Financial_Nature. An incentive may have more than one nature.</rdfs:comment>
        <rdfs:label xml:lang="en">Incentive Nature</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Incentive_Owner_Association -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Incentive_Owner_Association">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Association"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#relates_incentive_type"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#relates_owner_type"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_degree"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Degree to which an incentive type is suitable for, or used by, an owner type.</rdfs:comment>
        <rdfs:label xml:lang="en">Incentive-Owner Association</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Industrial -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Industrial">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/org#Organization"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Owner"/>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Industrial_Use -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Industrial_Use">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Primary_Use"/>
        <rdfs:comment xml:lang="en">Production, storage and logistics. Typically large flat roofs with high structural capacity.</rdfs:comment>
        <rdfs:label xml:lang="en">Industrial Use</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Industrial_and_Service_Districts -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Industrial_and_Service_Districts">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#District"/>
        <rdfs:comment xml:lang="en">Areas of production, logistics and services, characterised by large flat roofs.</rdfs:comment>
        <rdfs:label xml:lang="en">Industrial and Service Districts</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Industrial_and_Services -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Industrial_and_Services">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#District_Function"/>
        <rdfs:comment xml:lang="en">Districts functioning primarily as places of production and work.</rdfs:comment>
        <rdfs:label xml:lang="en">Industrial and Services</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Information_or_Engagement -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Information_or_Engagement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Informational_Instrument"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#applies_at_stage"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Pre-investment_Stage"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Informational_Instrument -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Informational_Instrument">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Incentive"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_incentive_nature"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Informational_Nature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Informational_Nature -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Informational_Nature">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Incentive_Nature"/>
        <rdfs:comment xml:lang="en">Operates by providing knowledge, advice, visibility or recognition.</rdfs:comment>
        <rdfs:label xml:lang="en">Informational Nature</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Institutional_Investors -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Institutional_Investors">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/org#Organization"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Owner"/>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Investment -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Investment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Fund"/>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Investment_Stage -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Investment_Stage">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Project_Stage"/>
        <rdfs:comment xml:lang="en">At the point of construction or installation, when capital expenditure occurs.</rdfs:comment>
        <rdfs:label xml:lang="en">Investment Stage</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Label_or_Recognition -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Label_or_Recognition">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Informational_Instrument"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#applies_at_stage"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Operation_Stage"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Landlords -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Landlords">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/org#Organization"/>
        <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Owner"/>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Late_20th_Century -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Late_20th_Century">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Construction_Era_and_Typology"/>
        <rdfs:comment xml:lang="en">Construction with modern structural codes and higher live load allowances (1976-2000).</rdfs:comment>
        <rdfs:label xml:lang="en">1976 - 2000</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Loan -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Loan">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Debt_instrument"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#applies_at_stage"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Investment_Stage"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Location -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Location">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Building_Attribute"/>
        <rdfs:comment xml:lang="en">The position of a building within the urban-to-rural gradient. The geographic position is given by GeoSPARQL geometry.</rdfs:comment>
        <rdfs:label xml:lang="en">Urban Location Context</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Loss_of_Nature_and_Biodiversity_Challenge -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Loss_of_Nature_and_Biodiversity_Challenge">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Urban_Challenge"/>
        <rdfs:comment xml:lang="en">Decline of species, habitats and ecological corridors in the city, including competing land demands such as food production.</rdfs:comment>
        <rdfs:label xml:lang="en">Loss of Nature and Biodiversity Challenge</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Low_Density -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Low_Density">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Urban_Density"/>
        <rdfs:comment xml:lang="en">Dispersed built form with high open-space ratios.</rdfs:comment>
        <rdfs:label xml:lang="en">Low Density</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Low_Rise -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Low_Rise">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Height"/>
        <rdfs:comment xml:lang="en">Buildings up to roughly three storeys. Easy access, low wind load, high overlooking from neighbours.</rdfs:comment>
        <rdfs:label xml:lang="en">Low Rise</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Mandating_or_Constraining -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Mandating_or_Constraining">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Incentive_Function"/>
        <rdfs:comment xml:lang="en">Obliges or forbids an action rather than encouraging it, altering the baseline against which the owner decides.</rdfs:comment>
        <rdfs:label xml:lang="en">Mandating or Constraining</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Mapping_Tools -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Mapping_Tools">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Tools"/>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Medium_Density -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Medium_Density">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Urban_Density"/>
        <rdfs:comment xml:lang="en">Moderately compact fabric, typical of interwar and postwar extensions.</rdfs:comment>
        <rdfs:label xml:lang="en">Medium Density</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Mid_Rise -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Mid_Rise">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Height"/>
        <rdfs:comment xml:lang="en">Buildings of roughly four to eight storeys. The most common context for collective rooftop projects.</rdfs:comment>
        <rdfs:label xml:lang="en">Mid Rise</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Mix_Use -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Mix_Use">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#District_Function"/>
        <rdfs:comment xml:lang="en">Districts with no single dominant function.</rdfs:comment>
        <rdfs:label xml:lang="en">Mix Use</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Modern -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Modern">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#City_Center"/>
        <rdfs:comment xml:lang="en">Recently developed or redeveloped parts of the core.</rdfs:comment>
        <rdfs:label xml:lang="en">Modern city center</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Municipal_Source -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Municipal_Source">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Public_Source"/>
        <rdfs:comment xml:lang="en">Public resources originating in city or local authority budgets.</rdfs:comment>
        <rdfs:label xml:lang="en">Municipal Source</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#National_Source -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#National_Source">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Public_Source"/>
        <rdfs:comment xml:lang="en">Public resources originating in national government budgets or agencies.</rdfs:comment>
        <rdfs:label xml:lang="en">National Source</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Negotiated_Allocation -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Negotiated_Allocation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Allocation_Mechanism"/>
        <rdfs:comment xml:lang="en">Terms are agreed bilaterally between the provider and the recipient rather than set in advance.</rdfs:comment>
        <rdfs:label xml:lang="en">Negotiated Allocation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Neighborhood_Center -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Neighborhood_Center">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Sub-center"/>
        <owl:disjointWith rdf:resource="https://w3id.org/rooftop_activation#Village_Center"/>
        <rdfs:comment xml:lang="en">A local hub serving the surrounding residential fabric.</rdfs:comment>
        <rdfs:label xml:lang="en">Neighborhood Center</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Non-Financial_Incentive -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Non-Financial_Incentive">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Incentive"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/rooftop_activation#Financial_Incentive"/>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Incentive"/>
        <rdfs:comment xml:lang="en">An incentive that does not operate by moving money or altering the cost of capital, acting instead through contractual, informational, organisational or regulatory levers. Defined class: an incentive that is not a financial incentive.</rdfs:comment>
        <rdfs:label xml:lang="en">Non-Financial Incentive</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Obligation_Attachment -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Obligation_Attachment">
        <rdfs:comment xml:lang="en">Facet capturing what the incentive&apos;s obligation or benefit is tied to, which determines whether it survives a change of occupant or owner. Functional: an incentive attaches to at most one of these. Used with has_obligation_attachment.</rdfs:comment>
        <rdfs:label xml:lang="en">Obligation Attachment</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Office_Use -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Office_Use">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Commercial_Use"/>
        <rdfs:comment xml:lang="en">Workplace buildings, a subtype of commercial use with distinctive daytime occupancy patterns.</rdfs:comment>
        <rdfs:label xml:lang="en">Office Use</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Offset_or_Deduction_Mechanism -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Offset_or_Deduction_Mechanism">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Contractual_or_Governance_Instrument"/>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#On-bill_Financing -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#On-bill_Financing">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Loan"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_incentive_nature"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Contractual_Nature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_obligation_attachment"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Attached_to_Property"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#On-bill_Repayment -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#On-bill_Repayment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#On-bill_Financing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#applies_at_stage"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Operation_Stage"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#On-tax_Financing -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#On-tax_Financing">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Loan"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_incentive_nature"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Fiscal_Nature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_obligation_attachment"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Attached_to_Property"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Operation_Stage -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Operation_Stage">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Project_Stage"/>
        <rdfs:comment xml:lang="en">After commissioning, covering use, maintenance, revenue and repayment.</rdfs:comment>
        <rdfs:label xml:lang="en">Operation Stage</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Orange_Rooftop -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Orange_Rooftop">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_function"/>
                        <owl:hasValue rdf:resource="https://w3id.org/rooftop_activation#Logistics_functions"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_function"/>
                        <owl:hasValue rdf:resource="https://w3id.org/rooftop_activation#Mobility_functions"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Rooftop"/>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Organizational_Nature -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Organizational_Nature">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Incentive_Nature"/>
        <rdfs:comment xml:lang="en">Operates by creating structures, programmes or governance arrangements through which action becomes possible.</rdfs:comment>
        <rdfs:label xml:lang="en">Organizational Nature</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Owner -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Owner">
        <rdfs:comment xml:lang="en">The party holding decision rights over a building and therefore over any rooftop activation. Subclasses distinguish owner types by their motivation, capital access and decision process.</rdfs:comment>
        <rdfs:label xml:lang="en">Owner</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Owner_Rooftop_Association -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Owner_Rooftop_Association">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Association"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#relates_owner_type"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#relates_rooftop_type"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_degree"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Degree to which an owner type is likely to activate a rooftop activation type.</rdfs:comment>
        <rdfs:label xml:lang="en">Owner-Rooftop Association</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Parks_Sport_Facilities -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Parks_Sport_Facilities">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Green_Areas"/>
        <owl:disjointWith rdf:resource="https://w3id.org/rooftop_activation#Rural_Areas"/>
        <rdfs:comment xml:lang="en">Designed and managed public open space.</rdfs:comment>
        <rdfs:label xml:lang="en">Parks Sport Facilities</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Peri-Urban_Location -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Peri-Urban_Location">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Location"/>
        <rdfs:comment xml:lang="en">At the urban fringe, where built fabric and open land interleave.</rdfs:comment>
        <rdfs:label xml:lang="en">Peri-Urban Location</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Person-based_Incentive -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Person-based_Incentive">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Incentive"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_obligation_attachment"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Attached_to_Person"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Incentive"/>
        <rdfs:comment xml:lang="en">An incentive whose benefits and obligations follow the individual or legal entity that receives it, and end or move with them if the property changes hands. Defined class: membership is inferred from has_obligation_attachment.</rdfs:comment>
        <rdfs:label xml:lang="en">Person-based Incentive</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Pitched_Type -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Pitched_Type">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Rooftop_Type"/>
        <rdfs:comment xml:lang="en">Sloped roof. Restricts activation largely to energy generation and lightweight interventions.</rdfs:comment>
        <rdfs:label xml:lang="en">Pitched Type</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Planning_Instrument -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Planning_Instrument">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Incentive"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_incentive_nature"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Organizational_Nature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Planning_or_Policy -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Planning_or_Policy">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Planning_Instrument"/>
        <owl:disjointWith rdf:resource="https://w3id.org/rooftop_activation#Program_or_Zoning_Approach"/>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Post_WWII -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Post_WWII">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Construction_Era_and_Typology"/>
        <rdfs:comment xml:lang="en">Reconstruction-era construction, often rapid and lightly built, with limited structural reserve (1946-1975).</rdfs:comment>
        <rdfs:label xml:lang="en">1946 - 1975</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Pre-financed_Grant -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Pre-financed_Grant">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Grant"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#applies_at_stage"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Pre-investment_Stage"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_incentive_function"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Reducing_Up-Front_Costs"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Pre-investment_Incentive -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Pre-investment_Incentive">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Incentive"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#applies_at_stage"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Pre-investment_Stage"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Incentive"/>
        <rdfs:comment xml:lang="en">An incentive that acts before the investment decision, supporting awareness, feasibility, design or preparation of a rooftop project. Defined class: membership is inferred from applies_at_stage.</rdfs:comment>
        <rdfs:label xml:lang="en">Pre-investment Incentive</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Pre-investment_Stage -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Pre-investment_Stage">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Project_Stage"/>
        <rdfs:comment xml:lang="en">Before the investment decision, covering awareness, feasibility, design and preparation.</rdfs:comment>
        <rdfs:label xml:lang="en">Pre-investment Stage</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Pre_1830 -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Pre_1830">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Construction_Era_and_Typology"/>
        <rdfs:comment xml:lang="en">Pre-industrial construction, typically load-bearing masonry with timber roof structures and frequent heritage protection (&lt; 1830)</rdfs:comment>
        <rdfs:label xml:lang="en">Before 1830</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Prefabricated -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Prefabricated">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Construction_Method"/>
        <owl:disjointWith rdf:resource="https://w3id.org/rooftop_activation#Traditional"/>
        <rdfs:comment xml:lang="en">Assembled from factory-produced components, with documented and repeatable load characteristics.</rdfs:comment>
        <rdfs:label xml:lang="en">Prefabricated</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Primary_Use -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Primary_Use">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Building_Attribute"/>
        <rdfs:comment xml:lang="en">The dominant function of the building itself, which determines who occupies it and who benefits from a rooftop intervention.</rdfs:comment>
        <rdfs:label xml:lang="en">Primary Use</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Private_Individual -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Private_Individual">
        <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Owner"/>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Private_Project_Developers -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Private_Project_Developers">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Owner"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/ns/org#Organization"/>
                    <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Person"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Private_Source -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Private_Source">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Funding_Source"/>
        <rdfs:comment xml:lang="en">Resources originating in commercial actors, including banks, investors, developers and utilities.</rdfs:comment>
        <rdfs:label xml:lang="en">Private Source</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Program_or_Zoning_Approach -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Program_or_Zoning_Approach">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Planning_Instrument"/>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Project_Stage -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Project_Stage">
        <rdfs:comment xml:lang="en">Facet capturing when in the rooftop activation lifecycle an incentive applies. An incentive may span several stages. Used with applies_at_stage.</rdfs:comment>
        <rdfs:label xml:lang="en">Project Stage</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Property-based_Incentive -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Property-based_Incentive">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Incentive"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_obligation_attachment"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Attached_to_Property"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Incentive"/>
        <rdfs:comment xml:lang="en">An incentive whose benefits and obligations follow the building or parcel, and transfer to the next owner or occupant. Defined class: membership is inferred from has_obligation_attachment.</rdfs:comment>
        <rdfs:label xml:lang="en">Property-based Incentive</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Property-linked_Loans -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Property-linked_Loans">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Loan"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_obligation_attachment"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Attached_to_Property"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Public-Private_Partnerships -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Public-Private_Partnerships">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Contractual_or_Governance_Instrument"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_funding_source"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Private_Source"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_funding_source"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Public_Source"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_incentive_function"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Raising_Additional_Capital"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_incentive_nature"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Organizational_Nature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Public_Source -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Public_Source">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Funding_Source"/>
        <rdfs:comment xml:lang="en">Resources originating in public budgets at any level of government.</rdfs:comment>
        <rdfs:label xml:lang="en">Public Source</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Public_and_Institutional_Use -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Public_and_Institutional_Use">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Primary_Use"/>
        <rdfs:comment xml:lang="en">Schools, hospitals, administration and other public facilities, where the owner is often the municipality.</rdfs:comment>
        <rdfs:label xml:lang="en">Public and Institutional Use</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Publicly_Funded_Incentive -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Publicly_Funded_Incentive">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Incentive"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_funding_source"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Public_Source"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Incentive"/>
        <rdfs:comment xml:lang="en">An incentive funded, fully or partly, by a public authority at European, national, regional or municipal level. Defined class: membership is inferred from has_funding_source.</rdfs:comment>
        <rdfs:label xml:lang="en">Publicly Funded Incentive</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Purple_Rooftop -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Purple_Rooftop">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_function"/>
                <owl:hasValue rdf:resource="https://w3id.org/rooftop_activation#Human_occupation_function"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Rooftop"/>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Raising_Additional_Capital -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Raising_Additional_Capital">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Incentive_Function"/>
        <rdfs:comment xml:lang="en">Mobilises third-party capital that would otherwise not reach the project, without necessarily lowering its total cost.</rdfs:comment>
        <rdfs:label xml:lang="en">Raising Additional Capital</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Real_Estate -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Real_Estate">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/org#Organization"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Owner"/>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Real_Estate_Corporate -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Real_Estate_Corporate">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Real_Estate"/>
        <owl:disjointWith rdf:resource="https://w3id.org/rooftop_activation#Real_Estate_Municipal"/>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Real_Estate_Municipal -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Real_Estate_Municipal">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Real_Estate"/>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Recreational_and_Nature -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Recreational_and_Nature">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#District_Function"/>
        <rdfs:comment xml:lang="en">Districts functioning primarily for leisure and ecological value.</rdfs:comment>
        <rdfs:label xml:lang="en">Recreational and Nature</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Red_Rooftop -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Red_Rooftop">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_function"/>
                <owl:hasValue rdf:resource="https://w3id.org/rooftop_activation#Social_use_function"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Rooftop"/>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Reducing_Transaction_Costs -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Reducing_Transaction_Costs">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Incentive_Function"/>
        <rdfs:comment xml:lang="en">Lowers the search, negotiation, procurement or administrative effort required to realise the project.</rdfs:comment>
        <rdfs:label xml:lang="en">Reducing Transaction Costs</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Reducing_Up-Front_Cost_Incentive -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Reducing_Up-Front_Cost_Incentive">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Incentive"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_incentive_function"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Reducing_Up-Front_Costs"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Incentive"/>
        <rdfs:comment xml:lang="en">An incentive whose function is to lower the initial capital an owner must commit to activate a rooftop. Defined class: membership is inferred from has_incentive_function.</rdfs:comment>
        <rdfs:label xml:lang="en">Reducing Up-Front Cost Incentive</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Reducing_Up-Front_Costs -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Reducing_Up-Front_Costs">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Incentive_Function"/>
        <rdfs:comment xml:lang="en">Lowers the capital the owner must mobilise at the moment of investment, whether by direct payment, discount or deferral.</rdfs:comment>
        <rdfs:label xml:lang="en">Reducing Up-Front Costs</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Region -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Region">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:comment xml:lang="en">A geographic area containing multiple districts, used for administrative and policy scoping.</rdfs:comment>
        <rdfs:label xml:lang="en">Region</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Regional_Source -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Regional_Source">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Public_Source"/>
        <rdfs:comment xml:lang="en">Public resources originating in regional or provincial authorities.</rdfs:comment>
        <rdfs:label xml:lang="en">Regional Source</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Regulation -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Regulation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Regulatory_Instrument"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_incentive_function"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Mandating_or_Constraining"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Regulatory_Constraint -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Regulatory_Constraint">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Building_Attribute"/>
        <rdfs:comment xml:lang="en">A binding rule that limits what may be built or done on a rooftop, independent of structural feasibility.</rdfs:comment>
        <rdfs:label xml:lang="en">Regulatory Constraint</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Regulatory_Incentive -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Regulatory_Incentive">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/rooftop_activation#Incentive"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_incentive_nature"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Regulatory_Nature"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Incentive"/>
        <rdfs:comment xml:lang="en">An incentive with a regulatory nature, acting through binding rules, permits or legal obligations. Defined class: membership is inferred from has_incentive_nature.</rdfs:comment>
        <rdfs:label xml:lang="en">Regulatory Incentive</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Regulatory_Instrument -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Regulatory_Instrument">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Incentive"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_incentive_nature"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Regulatory_Nature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Regulatory_Nature -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Regulatory_Nature">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Incentive_Nature"/>
        <rdfs:comment xml:lang="en">Operates through binding rules, permits, standards or mandatory disclosure.</rdfs:comment>
        <rdfs:label xml:lang="en">Regulatory Nature</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Religious_Institution -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Religious_Institution">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/org#Organization"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Owner"/>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Religious_Use -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Religious_Use">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Primary_Use"/>
        <rdfs:comment xml:lang="en">Places of worship and associated buildings, frequently heritage-protected.</rdfs:comment>
        <rdfs:label xml:lang="en">Religious Use</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Renting_or_Leasing -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Renting_or_Leasing">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Use_or_Access_Instrument"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_incentive_nature"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Financial_Nature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Residential -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Residential">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#District"/>
        <rdfs:comment xml:lang="en">Districts dominated by housing.</rdfs:comment>
        <rdfs:label xml:lang="en">Residential district</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Residential_Housing -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Residential_Housing">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#District_Function"/>
        <rdfs:comment xml:lang="en">Districts functioning primarily as places of residence.</rdfs:comment>
        <rdfs:label xml:lang="en">Residential Housing</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Residential_Use -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Residential_Use">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Primary_Use"/>
        <rdfs:comment xml:lang="en">Buildings used primarily for housing</rdfs:comment>
        <rdfs:label xml:lang="en">Residential Use</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Revolving -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Revolving">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Fund"/>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Revolving_Credit -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Revolving_Credit">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Loan"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_obligation_attachment"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Attached_to_Person"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Rooftop -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Rooftop">
        <rdfs:subClassOf rdf:resource="http://bimerr.iot.linkeddata.es/def/building#Roof"/>
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:comment xml:lang="en">The roof of a building considered as a potential site for activation, that is, for being put to a productive, ecological or social use. A rooftop is a GeoSPARQL feature. Its shape and position can be given by a geometry linked through geo:hasDefaultGeometry, normally a 3D polygon or multipolygon in WKT built from the RoofSurface surfaces of the building in a CityJSON model. Roof surfaces have no identifier in CityJSON, so a rooftop is linked to the city model through the building it is part of.</rdfs:comment>
        <rdfs:label xml:lang="en">Rooftop</rdfs:label>
        <skos:example xml:lang="en">ex:rooftop_001 a ra:Rooftop ;
    ra:is_part_of ex:building_001 ;
    geo:hasDefaultGeometry ex:rooftop_001_geom .

ex:rooftop_001_geom a geo:Geometry ;
    geo:asWKT &quot;&lt;http://www.opengis.net/def/crs/EPSG/0/XXXX&gt; MULTIPOLYGON Z (((x1 y1 z1, x2 y2 z2, x3 y3 z3, x1 y1 z1)))&quot;^^geo:wktLiteral .</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Rooftop_Challenge_Association -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Rooftop_Challenge_Association">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Association"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#relates_challenge"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Urban_Challenge"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#relates_rooftop_type"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_degree"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Degree to which a rooftop activation type contributes to addressing an urban challenge.</rdfs:comment>
        <rdfs:label xml:lang="en">Rooftop-Challenge Association</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Rooftop_Function -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Rooftop_Function">
        <rdfs:comment xml:lang="en">A specific activity or service performed on a rooftop, such as water retention, food production or energy generation. An activation type is realised through one or more functions.</rdfs:comment>
        <rdfs:label xml:lang="en">Rooftop Function</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Rooftop_Type -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Rooftop_Type">
        <rdfs:comment xml:lang="en">Classification of a rooftop by its geometry, which determines which activation types are physically feasible.</rdfs:comment>
        <rdfs:label xml:lang="en">Rooftop Type</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Rural_Areas -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Rural_Areas">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Green_Areas"/>
        <rdfs:comment xml:lang="en">Agricultural and undeveloped land within the wider urban region.</rdfs:comment>
        <rdfs:label xml:lang="en">Rural Areas</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Secured_Green -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Secured_Green">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Green_Bond"/>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Social_Inequality_and_Segregation_Challenge -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Social_Inequality_and_Segregation_Challenge">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Urban_Challenge"/>
        <rdfs:comment xml:lang="en">Uneven access to services, facilities and safe shared spaces, and spatial separation of social groups between neighbourhoods.</rdfs:comment>
        <rdfs:label xml:lang="en">Social Inequality and Segregation Challenge</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Standard_Green_Use_of_Proceeds_Bond -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Standard_Green_Use_of_Proceeds_Bond">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Green_Bond"/>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Steel -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Steel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Building_Material"/>
        <rdfs:comment xml:lang="en">Buildings whose dominant construction material is the one named.</rdfs:comment>
        <rdfs:label xml:lang="en">Steel</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Steward-Owned -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Steward-Owned">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Fund"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_funding_source"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Community_Source"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Stimulating_Market_or_Innovation -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Stimulating_Market_or_Innovation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Incentive_Function"/>
        <rdfs:comment xml:lang="en">Develops supply, demand or technology in the rooftop activation market beyond a single project.</rdfs:comment>
        <rdfs:label xml:lang="en">Stimulating Market or Innovation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Stone -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Stone">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Building_Material"/>
        <rdfs:comment xml:lang="en">Buildings whose dominant construction material is the one named.</rdfs:comment>
        <rdfs:label xml:lang="en">Stone</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Sub-center -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Sub-center">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#District"/>
        <rdfs:comment xml:lang="en">A secondary concentration of activity within the urban area.</rdfs:comment>
        <rdfs:label xml:lang="en">Sub-center</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Subsidy -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Subsidy">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Direct_Transfer_Instrument"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#applies_at_stage"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Operation_Stage"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_obligation_attachment"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Attached_to_Project"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Suburban_Location -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Suburban_Location">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Location"/>
        <rdfs:comment xml:lang="en">In the lower-density belt surrounding the urban core.</rdfs:comment>
        <rdfs:label xml:lang="en">Suburban Location</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Sustainable_and_Equitable_Mobility_Challenge -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Sustainable_and_Equitable_Mobility_Challenge">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Urban_Challenge"/>
        <rdfs:comment xml:lang="en">Congestion, pressure on public space from parking, and lack of infrastructure for walking, cycling and shared mobility.</rdfs:comment>
        <rdfs:label xml:lang="en">Sustainable and Equitable Mobility Challenge</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#TAX_or_VAT_Incentive -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#TAX_or_VAT_Incentive">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Fiscal_Instrument"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_allocation_mechanism"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Entitlement_Allocation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_obligation_attachment"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Attached_to_Person"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Tax_Credit -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Tax_Credit">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Fiscal_Instrument"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_allocation_mechanism"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Entitlement_Allocation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_obligation_attachment"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Attached_to_Person"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Tools -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Tools">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Informational_Instrument"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#applies_at_stage"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Pre-investment_Stage"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Traditional -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Traditional">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Construction_Method"/>
        <rdfs:comment xml:lang="en">Built in place, requiring individual structural assessment before rooftop loads are added.</rdfs:comment>
        <rdfs:label xml:lang="en">Traditional</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Transition_to_a_Circular_Economy_Challenge -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Transition_to_a_Circular_Economy_Challenge">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Urban_Challenge"/>
        <rdfs:comment xml:lang="en">Low recycling and material reuse, and resource flows such as waste and water that are managed linearly rather than kept in use.</rdfs:comment>
        <rdfs:label xml:lang="en">Transition to a Circular Economy Challenge</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Unused -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Unused">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#District_Function"/>
        <rdfs:comment xml:lang="en">Districts with no current active function.</rdfs:comment>
        <rdfs:label xml:lang="en">Unused</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Unused_Areas -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Unused_Areas">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#District"/>
        <rdfs:comment xml:lang="en">Vacant, derelict or awaiting-development land.</rdfs:comment>
        <rdfs:label xml:lang="en">Unused Areas</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Urban -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Urban">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Residential"/>
        <rdfs:comment xml:lang="en">Compact residential fabric with limited open space.</rdfs:comment>
        <rdfs:label xml:lang="en">Urban residential district</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Urban_Challenge -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Urban_Challenge">
        <rdfs:comment xml:lang="en">A structural problem faced by a city that rooftop activation can help address. Used to link owner and district priorities to suitable activation types.</rdfs:comment>
        <rdfs:label xml:lang="en">Urban Challenge</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Urban_Density -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Urban_Density">
        <rdfs:comment xml:lang="en">The intensity of built form and population in a district.</rdfs:comment>
        <rdfs:label xml:lang="en">Urban Density</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Urban_Green -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Urban_Green">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Residential"/>
        <rdfs:comment xml:lang="en">Compact residential fabric with significant integrated greenery.</rdfs:comment>
        <rdfs:label xml:lang="en">Urban Green residential district</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Urban_Health_and_Well-being_Challenge -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Urban_Health_and_Well-being_Challenge">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Urban_Challenge"/>
        <rdfs:comment xml:lang="en">Environmental and social conditions that harm physical and mental health, such as poor air quality, noise, loneliness and lack of green space and facilities.</rdfs:comment>
        <rdfs:label xml:lang="en">Urban Health and Well-being Challenge</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Urban_Location -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Urban_Location">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Location"/>
        <rdfs:comment xml:lang="en">Within the continuous built-up fabric of a city.</rdfs:comment>
        <rdfs:label xml:lang="en">Urban Location</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Use_or_Access_Instrument -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Use_or_Access_Instrument">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Incentive"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_incentive_function"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Reducing_Up-Front_Costs"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Very_High_Density -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Very_High_Density">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#High_Density"/>
        <rdfs:comment xml:lang="en">The most compact built fabric, with continuous, tall building blocks and almost no open space at ground level.</rdfs:comment>
        <rdfs:label xml:lang="en">Very High Density</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Very_High_Rise -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Very_High_Rise">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#High_Rise"/>
        <rdfs:comment xml:lang="en">The tallest buildings, where wind, evacuation and structural constraints dominate feasibility.</rdfs:comment>
        <rdfs:label xml:lang="en">Very High Rise</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Very_Low_Density -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Very_Low_Density">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Low_Density"/>
        <rdfs:comment xml:lang="en">Sparse, scattered built form dominated by open land, typical of peri-urban and rural edges.</rdfs:comment>
        <rdfs:label xml:lang="en">Very Low Density</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Village_Center -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Village_Center">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Sub-center"/>
        <rdfs:comment xml:lang="en">A formerly independent settlement absorbed into the urban area.</rdfs:comment>
        <rdfs:label xml:lang="en">Village Center</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Voucher -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Voucher">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Direct_Transfer_Instrument"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#applies_at_stage"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Investment_Stage"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_incentive_function"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Reducing_Up-Front_Costs"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_obligation_attachment"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/rooftop_activation#Attached_to_Person"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Wind_Load_Regulation -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Wind_Load_Regulation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Regulatory_Constraint"/>
        <rdfs:comment xml:lang="en">Requirements on the resistance of rooftop elements to wind, scaling with building height and exposure.</rdfs:comment>
        <rdfs:label xml:lang="en">Wind Load Regulation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Wood -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Wood">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Building_Material"/>
        <rdfs:comment xml:lang="en">Buildings whose dominant construction material is the one named.</rdfs:comment>
        <rdfs:label xml:lang="en">Wood</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#Yellow_Rooftop -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#Yellow_Rooftop">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/rooftop_activation#has_function"/>
                <owl:hasValue rdf:resource="https://w3id.org/rooftop_activation#Energy_generation_function"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Rooftop"/>
    </owl:Class>
    


    <!-- https://w3id.org/rooftop_activation#21st_Century -->

    <owl:Class rdf:about="https://w3id.org/rooftop_activation#21st_Century">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rooftop_activation#Construction_Era_and_Typology"/>
        <rdfs:comment xml:lang="en">Contemporary construction, typically insulated, code-compliant and most readily adapted for rooftop use (&gt; 2000).</rdfs:comment>
        <rdfs:label xml:lang="en">After 2000</rdfs:label>
    </owl:Class>
    


